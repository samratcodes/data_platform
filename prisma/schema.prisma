generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model access_requests {
  id            String   @id @db.Uuid
  user_id       String   @db.Uuid
  operator_slug String
  purpose       String
  status        String   @default("pending")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, operator_slug])
  @@index([operator_slug, created_at(sort: Desc)], map: "access_requests_operator_idx")
}

model admin_audit_logs {
  id            String   @id @db.Uuid
  admin_user_id String   @db.Uuid
  action        String
  target_type   String
  target_id     String
  metadata      Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users    @relation(fields: [admin_user_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "admin_audit_logs_created_idx")
}

model auth_attempts {
  key      String @id
  attempts Int
  reset_at BigInt
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth_tokens {
  id          String    @id @db.Uuid
  user_id     String    @db.Uuid
  purpose     String
  token_hash  String    @unique
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  attempts    Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "auth_tokens_expires_idx")
  @@index([user_id, purpose, created_at(sort: Desc)], map: "auth_tokens_user_purpose_idx")
}

model concierge_requests {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  brief      String
  budget     String?
  timeline   String?
  status     String   @default("new")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, created_at(sort: Desc)], map: "concierge_requests_status_idx")
}

model conversations {
  id                                     String     @id @db.Uuid
  buyer_id                               String     @db.Uuid
  supplier_id                            String?    @db.Uuid
  operator_slug                          String
  created_at                             DateTime   @default(now()) @db.Timestamptz(6)
  users_conversations_buyer_idTousers    users      @relation("conversations_buyer_idTousers", fields: [buyer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_conversations_supplier_idTousers users?     @relation("conversations_supplier_idTousers", fields: [supplier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages                               messages[]

  @@unique([buyer_id, supplier_id, operator_slug])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model email_outbox {
  id                  String    @id @db.Uuid
  user_id             String?   @db.Uuid
  recipient_email     String
  purpose             String
  subject             String
  body_text           String
  status              String    @default("queued")
  provider_message_id String?
  last_error          String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  sent_at             DateTime? @db.Timestamptz(6)
  attempts            Int       @default(0)
  available_at        DateTime  @default(now()) @db.Timestamptz(6)
  users               users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([status, available_at, created_at], map: "email_outbox_ready_idx")
  @@index([status, created_at], map: "email_outbox_status_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model integration_outbox {
  id           String    @id @db.Uuid
  event_type   String
  entity_id    String    @db.Uuid
  status       String    @default("pending")
  attempts     Int       @default(0)
  available_at DateTime  @default(now()) @db.Timestamptz(6)
  last_error   String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
  users        users     @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_type, entity_id])
  @@index([status, available_at, created_at], map: "integration_outbox_ready_idx")
}

model messages {
  id              String        @id @db.Uuid
  conversation_id String        @db.Uuid
  sender_id       String        @db.Uuid
  body            String
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at], map: "messages_conversation_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model providers {
  id                 Int      @id @default(autoincrement())
  owner_id           String?  @db.Uuid
  slug               String   @unique
  name               String
  city               String
  country            String
  longitude          Float
  latitude           Float
  provider_type      String
  modalities         Json     @default("[]")
  media              Json     @default("{}")
  profile            Json     @default("{}")
  verification_level String   @default("online")
  status             String   @default("approved")
  profile_views      Int      @default(0)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
  is_demo            Boolean  @default(false)
  users              users?   @relation(fields: [owner_id], references: [id], onUpdate: NoAction)

  @@index([status, verification_level], map: "providers_status_idx")
}

model saved_operators {
  user_id       String   @db.Uuid
  operator_slug String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, operator_slug])
}

model sessions {
  token_hash String @id
  user_id    String @db.Uuid
  expires_at BigInt
  users      users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model supplier_applications {
  id                   String    @id @db.Uuid
  user_id              String    @db.Uuid
  business_name        String
  maps_url             String?
  physical_address     String?
  city                 String?
  country              String?
  longitude            Float?
  latitude             Float?
  hardware_pictures    Json      @default("[]")
  office_images        Json      @default("[]")
  official_documents   Json      @default("[]")
  linkedin_url         String?
  twitter_url          String?
  huggingface_url      String?
  website_url          String?
  provider_type        String
  modalities           Json      @default("[]")
  robotics_types       Json      @default("[]")
  status               String    @default("pending")
  verification_level   String    @default("unverified")
  admin_notes          String?
  submitted_at         DateTime  @default(now()) @db.Timestamptz(6)
  reviewed_at          DateTime? @db.Timestamptz(6)
  application_kind     String    @default("company")
  profile_description  String    @default("")
  capacity             String    @default("")
  capture_environments Json      @default("[]")
  provider_slug        String?   @unique(map: "applications_provider_slug_idx", where: raw("(provider_slug IS NOT NULL)"))
  sample_file_name     String?
  sample_mime_type     String?
  sample_size_bytes    Int?
  sample_data          Bytes?
  users                users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "applications_status_idx")
  @@index([user_id, application_kind, submitted_at(sort: Desc)], map: "applications_user_kind_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                             String                  @id @db.Uuid
  name                                           String
  email                                          String                  @unique
  password_hash                                  String
  role                                           String                  @default("buyer")
  created_at                                     DateTime                @default(now()) @db.Timestamptz(6)
  email_verified_at                              DateTime?               @db.Timestamptz(6)
  password_changed_at                            DateTime?               @db.Timestamptz(6)
  access_requests                                access_requests[]
  admin_audit_logs                               admin_audit_logs[]
  auth_tokens                                    auth_tokens[]
  concierge_requests                             concierge_requests[]
  conversations_conversations_buyer_idTousers    conversations[]         @relation("conversations_buyer_idTousers")
  conversations_conversations_supplier_idTousers conversations[]         @relation("conversations_supplier_idTousers")
  email_outbox                                   email_outbox[]
  integration_outbox                             integration_outbox[]
  messages                                       messages[]
  providers                                      providers[]
  saved_operators                                saved_operators[]
  sessions                                       sessions[]
  supplier_applications                          supplier_applications[]
}
