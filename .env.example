# Use one PostgreSQL connection variable. DATABASE_URL is recommended.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Keep TLS certificate verification enabled. Set to false only for a trusted
# database provider that explicitly requires a self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Optional public Mapbox token. MapLibre works without it.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional secure admin seed. Set both values before `npm run db:seed`.
# Never commit a real password. Use at least 12 characters.
ADMIN_SEED_NAME=map.filemarket Admin
ADMIN_SEED_EMAIL=seed@filemarket.ai
ADMIN_SEED_PASSWORD=use-a-unique-password-of-at-least-12-characters

# Contact URL or email included in server-side geocoding requests.
GEOCODING_CONTACT=https://filemarket.ai

# Public app origin used inside verification and password-reset links.
APP_URL=http://localhost:3000

# Transactional email delivery through Resend. Verification and password-reset
# messages send immediately; failed or deferred outbox messages can be retried
# with `npm run emails:send`.
EMAIL_PROVIDER=resend
EMAIL_FROM="map.filemarket <noreply@security.filemarket.ai>"
EMAIL_REPLY_TO="noreply@security.filemarket.ai"
RESEND_API_KEY=re_your_resend_api_key

# Google Sheets operational user directory. PostgreSQL remains the source of truth.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_USERS_WORKSHEET=Users
GOOGLE_SHEETS_COMPANIES_WORKSHEET=Data Companies
GOOGLE_SHEETS_FACILITIES_WORKSHEET=Facilities
GOOGLE_SHEETS_DATA_REQUESTS_WORKSHEET=Data Requests
GOOGLE_SHEETS_CONCIERGE_WORKSHEET=Concierge Briefs
GOOGLE_SHEETS_SAVED_PROVIDERS_WORKSHEET=Saved Providers
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Preserve escaped newlines when storing the key on one line: -----BEGIN...-----\n...\n-----END...-----\n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Generate a long random value and configure the same value in Vercel. Vercel
# sends it automatically as a Bearer token when calling the scheduled sync route.
CRON_SECRET=
